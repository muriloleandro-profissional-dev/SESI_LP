#include <stdio.h>

int main() {
    int numeros[10];
    int pares[10], impares[10];
    int contPar = 0, contImpar = 0;

    
    for(int i = 0; i < 10; i++) {
        printf("Digite o %d o. numero: ", i + 1);
        scanf("%d", &numeros[i]);
    }

    
    for(int i = 0; i < 10; i++) {
        if(numeros[i] % 2 == 0) {
            pares[contPar] = numeros[i]; 
            contPar++;                   
        } else {
            impares[contImpar] = numeros[i]; 
            contImpar++;                     
        }
    }

    
    printf("\n--- RESULTADOS ---\n");
    
    printf("Numeros PARES (%d encontrados): ", contPar);
    for(int i = 0; i < contPar; i++) {
        printf("%d ", pares[i]);
    }

    printf("\nNumeros IMPARES (%d encontrados): ", contImpar);
    for(int i = 0; i < contImpar; i++) {
        printf("%d ", impares[i]);
    }

    printf("\n");

    return 0;
}