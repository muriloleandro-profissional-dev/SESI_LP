#include <stdio.h>

int main() {
    float notas[10];
    float soma = 0, media;
    int i, acimaMedia = 0;

    
    for(i = 0; i < 10; i++) {
        printf("Digite a nota do aluno %d: ", i + 1);
        scanf("%f", &notas[i]);
        soma += notas[i];
    }

    
    media = soma / 10;
    printf("\nMedia da turma: %.2f\n", media);

    
    for(i = 0; i < 10; i++) {
        if(notas[i] > media) {
            acimaMedia++;
        }
    }

    printf("Quantidade de alunos acima da media: %d\n", acimaMedia);

    
    printf("\nNotas acima da media:\n");
    for(i = 0; i < 10; i++) {
        if(notas[i] > media) {
            printf("%.2f\n", notas[i]);
        }
    }

    return 0;
}