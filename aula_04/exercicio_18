#include <stdio.h>

int main() {
    int idade, soma = 0, contador = 0;
    float media;

    do {
        printf("Digite uma idade (0 para parar): ");
        scanf("%i", &idade);

        if(idade != 0) {   
            soma += idade;
            contador++;
        }

    } while(idade != 0);

    if(contador > 0) {
        media = (float)soma / contador; 
        printf("A média das idades digitadas é: %.2f\n", media);
    } else {
        printf("Nenhuma idade foi digitada.\n");
    }

    return 0;
}