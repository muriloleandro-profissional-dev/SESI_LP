#include <stdio.h>

int main(){
    
    int numero = 0, i = 1, fatorial = 1;
    
    printf("Me diga o número e calcularei o fatorial dele: ");
    scanf("%i", &numero);
    
    for(i = 1; i <= numero; i++){
        
        
        fatorial = fatorial * i;
        printf("%i\n", fatorial);
            
    }
    
}