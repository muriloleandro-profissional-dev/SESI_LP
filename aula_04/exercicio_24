#include <stdio.h>

int main() {
    int numero, i, primo = 1;

    scanf("%i", &numero);

    if(numero <= 1){
        primo = 0;  
    } else {
        for(i = 2; i < numero; i++){
            if(numero % i == 0){
                primo = 0; 
                break;
            }
        }
    }

    if(primo)
        printf("1\n");  
    else
        printf("0\n");  

    return 0;
}