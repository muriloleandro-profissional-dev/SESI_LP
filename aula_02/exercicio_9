#include <stdio.h>


int main(){
    
    float numero;
    
    printf("Me diga o número");
    scanf("%f", &numero);
    
    if(numero < 0){
        printf("%f é um número menor que 0, é negativo/n", numero);
    }
    
    else if(numero == 0){
        printf("%f é um número igual a 0/n", numero);
        
    }
    
    else if(numero > 0){
        printf("%f é um número maior que 0, é positivo/n", numero);
        
    }
}