#include <stdio.h>

int main(){
    int idade;
    
    printf("Qual sua idade?");
    scanf("%i", &idade);
    
    if(idade<16){
        printf("Não pode votar");
    }
    else if(16<=idade && idade < 18){
        printf("Pode votar se quiser");
    }
    else if(idade>=18){
        printf("Voto obrigatório");
    }
}