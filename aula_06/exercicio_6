#include <stdio.h>

int main(){
    
    int  numero[10];
    
    for(int i=0; i < 10; i++){
        
        printf("\nMe diga o %i número: ", i+1);
        scanf("%i", &numero[i]);
        
        
        
    }
    
    for(int i=0; i < 10; i++){
        
        if(numero[i] > 0){
            printf("\nO número %i é positivo", numero[i]);
        }
        
    }
    
}