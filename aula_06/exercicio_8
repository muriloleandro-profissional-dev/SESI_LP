#include <stdio.h>

int main(){
    
    float numero[10], soma=0, media=0;
    
    for(int i=0; i < 10; i++){
        
        printf("\nMe diga o número %i: ", i+1);
        scanf("%f", &numero[i]);
        
        soma = soma + numero[i];
        
        media = soma / 10;
        
        }
    
    
    
        
    for(int i=0; i < 10; i++){
        
        if(numero[i] > media){
            printf("\nOs valores %.2f são maiores que a média", numero[i]);
            }
        
        }
    
}
