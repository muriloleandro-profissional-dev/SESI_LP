#include <stdio.h>

int main(){
    
    float numero[10];
    
    for(int i=0; i <10; i++){
        
        printf("Me diga o número %i:   ", i+1);
        scanf("%f", &numero[i]);
        
    }
    
    for(int i=0; i < 10; i++){
        
        if(numero[i] < 0){
            printf("O número %.2f é negativos e ele se tornou zero:  \n", numero[i]);
            numero[i] = 0;
            
            
        }
        
    }
    
    for(int i=0; i < 10; i++){
        
        printf("\n%.2f", numero[i]);
    }
    
}