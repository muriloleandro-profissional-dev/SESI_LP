#include <stdio.h>

int main(){
    
    int numero[6];
    int maior; 
    
    
    for(int i=0; i < 6; i++){
        printf("Me diga o %i número: ", i+1);
        scanf("%d", &numero[i]);
    }
    
    
    maior = numero[0];
    
    
    for(int i = 1; i < 6; i++){
        if(numero[i] < maior){
            maior = numero[i]; 
        }
    }
    
    
    printf("\nO menor valor digitado foi: %d\n", maior);

    return 0;
}