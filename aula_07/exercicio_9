#include <stdio.h>

int main(){
    
    int matriz[5][5];
    
    for(int l=0; l < 5; l++){
        for(int c=0; c < 5; c++){
            printf("Digite o número da linha %i e coluna %i: ", l+1, c+1);
            scanf("%i", &matriz[l][c]);
        }
    }

    printf("\n--- Matriz Corrigida (Sem Negativos) ---\n");
    for(int l=0; l < 5; l++){
        for(int c=0; c < 5; c++){
            
            if(matriz[l][c] < 0){
                matriz[l][c] = 0;
            }
            
      
            printf(" | %i ", matriz[l][c]);
        }
        printf("\n");
    }

    return 0;
}